# peninggalan fitur token headless yang sudah dicabut: tetap diabaikan supaya
# berkas lama di mesin siapa pun tidak pernah ikut ter-commit
.agent-room-token

# riwayat token: data pemakaian pribadi, bukan kode
token-riwayat.jsonl
token-riwayat.arsip.jsonl

# arsip kliping mingguan: data lokal, bukan kode
kliping-mingguan.jsonl
kliping-berjalan.json

# buku agenda: log event harian (metadata), data lokal, bukan kode
agenda/

# buku induk pegawai: karier per folder proyek, data lokal, bukan kode
buku-induk.json
buku-induk.json.tmp

# pagu anggaran token per proyek: setelan + serapan lokal, bukan kode
# (pagu.contoh.json justru IKUT di-commit; itu contoh untuk dibaca manusia)
pagu.json
pagu.json.tmp

# formasi pegawai tetap: nama & jabatan penghuni kursi per folder, data lokal
formasi.json
formasi.json.tmp

# suara ucap: setelan, kunci OpenRouter, dan cache klip — data lokal, bukan kode
suara.json
suara.json.tmp
.agent-room-suara-kunci
suara/

# daftar nama pegawai pilihanmu: data lokal (daftar bawaan ada di server.mjs)
nama.json
nama.json.tmp
